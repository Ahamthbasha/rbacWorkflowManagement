{
  "name": "rbac-backend",
  "version": "0.1.0",
  "main": "dist/app.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "db:migrate": "cross-env TS_NODE_TRANSPILE_ONLY=true npx sequelize-cli db:migrate",
"db:migrate:undo": "cross-env TS_NODE_TRANSPILE_ONLY=true npx sequelize-cli db:migrate:undo",
"db:migrate:undo:all": "cross-env TS_NODE_TRANSPILE_ONLY=true npx sequelize-cli db:migrate:undo:all",
"db:seed": "cross-env TS_NODE_TRANSPILE_ONLY=true npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo",
    "db:seed:undo:all": "npx sequelize-cli db:seed:undo:all",
    "db:create": "npx sequelize-cli db:create",
    "db:drop": "npx sequelize-cli db:drop",
    "migration:generate": "npx sequelize-cli migration:generate --name",
    "seed:generate": "npx sequelize-cli seed:generate --name"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.22.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mysql2": "^3.3.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.0.0",
    "@types/sequelize": "^4.28.20",
    "@types/umzug": "^2.3.9",
    "cross-env": "^10.1.0",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "umzug": "^3.8.0"
  }
}
